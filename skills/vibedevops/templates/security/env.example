# ============================================================
# .env.example — 提交到 git 的"假"环境变量文件
# 规则：真 .env 永不入库（gitignore），本文件只放变量名 + 说明 + 假值
# 新人上手：cp .env.example .env，然后找负责人要真值——或直接用 Infisical 拉取
# ============================================================

# --- 应用 ---
APP_ENV=development            # development / staging / production
PORT=3000

# --- 数据库 ---
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# --- 第三方密钥（真值绝不写在这里）---
OPENAI_API_KEY=sk-xxxxxxxx     # 从 Infisical 拉取：infisical run -- <启动命令>
STRIPE_SECRET_KEY=sk_test_xxxx

# --- 运维 ---
SENTRY_DSN=                    # 错误追踪，留空=关闭
LOG_LEVEL=info
